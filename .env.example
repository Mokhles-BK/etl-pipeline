# Copy to .env and fill in values before running.

# --- Database (PostgreSQL) ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=etl
DB_USER=etluser
DB_PASSWORD=devpass

# --- Data source ---
# USGS FDSNWS earthquake feed (no API key required).
# https://earthquake.usgs.gov/fdsnws/event/1/query?format=geojson
USGS_BASE_URL=https://earthquake.usgs.gov/fdsnws/event/1
USGS_MIN_MAGNITUDE=1.0

# --- Pipeline behavior ---
BATCH_SIZE=100
LOAD_MODE=upsert   # upsert | append